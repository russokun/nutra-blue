{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "apps/web"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "web-prod",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["vite", "preview", "--outDir", "apps/web/dist"],
      "port": 4173,
      "autoPort": true
    },
    {
      "name": "api",
      "runtimeExecutable": "apps/api/.venv/Scripts/python.exe",
      "runtimeArgs": ["apps/api/main.py"],
      "port": 3001
    },
    {
      "name": "admin",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "apps/admin"],
      "port": 3002,
      "autoPort": true
    }
  ]
}
